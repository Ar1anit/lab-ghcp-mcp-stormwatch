<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormWatch\StormWatch.csproj" />
    <Compile Include="..\..\starter\StormWatch.Tests\Usings.cs" Link="Usings.cs" />
    <Compile Include="..\..\starter\StormWatch.Tests\TestData.cs" Link="TestData.cs" />
    <Compile Include="..\..\starter\StormWatch.Tests\WeatherTests.cs" Link="WeatherTests.cs" />
    <Compile Include="..\..\starter\StormWatch.Tests\RiskTests.cs" Link="RiskTests.cs" />
    <Compile Include="..\..\starter\StormWatch.Tests\AppTests.cs" Link="AppTests.cs" />
    <None Include="..\..\starter\tests\fixtures\forecast.json"
          Link="fixtures\forecast.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

